{
  "name": "web-traffic-speedometer",
  "version": "3.8.1",
  "description": "Network connectivity and throughput logger — seven parallel probes graded into three everyday activities, with GPS, one JSON file per session. Runs in the browser, no backend.",
  "license": "0BSD",
  "private": false,
  "type": "module",
  "scripts": {
    "test": "node tests/run.mjs",
    "lint": "eslint .",
    "test:unit": "node tests/unit.mjs",
    "test:security": "node tests/security.mjs",
    "test:browser": "node tests/browser.mjs",
    "serve": "python3 -m http.server 8731",
    "test:edges": "node tests/edges.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.10.0",
    "eslint-plugin-sonarjs": "^4.2.0",
    "globals": "^17.12.0",
    "playwright": "^1.62.1"
  }
}
