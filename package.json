{
  "name": "web-traffic-speedometer",
  "version": "3.7.0",
  "description": "Mobile connectivity and throughput logger for train journeys — seven parallel probes, GPS, one JSON file per ride. Runs in the browser, no backend.",
  "license": "0BSD",
  "private": false,
  "type": "module",
  "scripts": {
    "test": "node tests/run.mjs",
    "lint": "eslint .",
    "test:unit": "node tests/unit.mjs",
    "test:security": "node tests/security.mjs",
    "test:browser": "node tests/browser.mjs",
    "serve": "python3 -m http.server 8731",
    "test:edges": "node tests/edges.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.10.0",
    "eslint-plugin-sonarjs": "^4.2.0",
    "globals": "^17.12.0",
    "playwright": "^1.62.1"
  }
}
